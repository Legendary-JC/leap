{% set p = pages[pageKey] %}
<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1, viewport-fit=cover'
    />
    <title>
      {% if pageKey == "home" %}
        {{ site.name }} – {{ site.fullName }}
      {% else %}
        {{ p.title }} | {{ site.name }}
      {% endif %}
    </title>
    <meta
      name='description'
      content='{{ p.description or site.description }}'
    />
    <link
      href='https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600&display=swap'
      rel='stylesheet'
    />
    <link rel="icon" href="{{ '/img/favicon.png' | url }}">
    <link rel='stylesheet' href="{{ '/css/styles.css' | url }}" />
    <link rel="icon" href="{{ '/img/favicon.ico' | url }}" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/img/favicon-32.png' | url }}">
    <link rel="apple-touch-icon" href="{{ '/img/apple-touch-icon.png' | url }}">
  </head>
  <body>
    {% include "partials/defs.njk" %}
    {% include "partials/header.njk" %}
    <main>{{ content | safe }}</main>
    {% include "partials/footer.njk" %}
    <script src="{{ '/js/main.js' | url }}"></script>
  </body>
</html>
